# ── Base de datos (obligatoria) ─────────────────────────────────────────────
# Neon (https://neon.tech, free tier) o cualquier Postgres 14+.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Acceso (obligatorio: al menos una de las dos formas) ────────────────────
# Código de acceso (8+ caracteres). Se manda como header x-access-code.
ACCESS_CODE=
# Login con Google (recomendado). Redirect URI: https://<tu-dominio>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Firma de la cookie de sesión: `openssl rand -base64 32`
AUTH_SECRET=
# Mails habilitados, separados por coma.
ALLOWED_EMAILS=
# Origen canónico (si la app se sirve desde más de un dominio).
# CANONICAL_ORIGIN=https://studio.tudominio.com

# ── Motor de clips ──────────────────────────────────────────────────────────
# Gemini mira el episodio por URL y busca los mejores tramos. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# OpenAI redacta los captions (Structured Outputs).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_REASONING=low

# ── El canal y la cuenta ────────────────────────────────────────────────────
# Id del canal de YouTube (empieza con UC…). Se lee el RSS público: sin OAuth.
YOUTUBE_CHANNEL_ID=
# Handles públicos, sin @ (para el sync de métricas con Apify).
TIKTOK_USERNAME=
INSTAGRAM_USERNAME=

# ── Marca (lo ve el navegador: nada secreto acá) ────────────────────────────
NEXT_PUBLIC_BRAND_NAME=Clip Studio
NEXT_PUBLIC_BRAND_ACCENT=#ff6a00
NEXT_PUBLIC_TIMEZONE=America/Argentina/Buenos_Aires
NEXT_PUBLIC_LOCALE=es-AR
# Entra a los prompts.
PODCAST_NAME=Mi Podcast
PODCAST_DESCRIPTION=un podcast de entrevistas sobre negocios
CONTENT_LANGUAGE=español rioplatense, con voseo natural
# Hashtag de la marca (sin #). Si está, se exige en todas las captions.
BRAND_HASHTAG=
# CTA fijo que cierra cada caption.
CTA_TEXT=▶️ Episodio completo en YouTube

# ── Plan de publicación ─────────────────────────────────────────────────────
# Días ISO en que sale un clip (1=lunes … 7=domingo). Default: 1,2,3,4,5,6
# WEEKLY_PLAN=1,2,3,4,5,6
# PUBLISH_TIME=21:00
# CLIPS_PER_EPISODE=5
# STRETCH_EXTRA_CLIPS=2
# EPISODE_MIN_SEC=1200
# CLIP_CANDIDATES=10

# ── Cron ────────────────────────────────────────────────────────────────────
# Vercel lo manda como Bearer al cron diario. `openssl rand -hex 32`
CRON_SECRET=

# ── Métricas (opcionales) ───────────────────────────────────────────────────
# Apify: scrapea los perfiles públicos de TikTok e Instagram. https://console.apify.com/account/integrations
APIFY_TOKEN=
# YouTube Data API v3 (views/likes/comments de los Shorts).
YOUTUBE_API_KEY=
# Upstash QStash: checkpoints de métricas a las 5 h, 24 h y 7 d de publicar.
QSTASH_URL=
QSTASH_TOKEN=
